#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

# Fill this with the executable path.
PROG="/usr/bin/tmux-web"

# Optional runtime settings.
RUN_USER="root"
RUN_GROUP=""
RESPAWN=1
STDOUT=1
STDERR=1
INSTANCE_NAME="main"

# Optional health check command. Leave empty if unused.
# Example:
# CHECK_CMD="/usr/bin/your-command"
# CHECK_ARGS="status"
CHECK_CMD=""
CHECK_ARGS=""

extra_command "status" "Show service running status"
extra_command "health" "Run optional health check command"

add_command_args() {
        # Add arguments one by one.
        # Example command:
        #   /usr/bin/your-command -c /etc/your.conf --port 8080
        #
        # Fill like this:
        procd_append_param command "--host"
        procd_append_param command "0.0.0.0"
        procd_append_param command "--port"
        procd_append_param command "2224"
        procd_append_param command "--theme"
        procd_append_param command "auto"
        procd_append_param command "--token"
        procd_append_param command "adie2387"
        procd_append_param command "--error-count"
        procd_append_param command "5"
        procd_append_param command "--black-file"
        procd_append_param command "/root/tmux-web-black"
        procd_append_param command "--hide-session-bar"
        # procd_append_param command "--key /tmp/root/.config/certs/server.local-key.pem"
        :
}

start_service() {
        if [ ! -x "$PROG" ]; then
                echo "not executable: $PROG"
                return 1
        fi

        procd_open_instance "$INSTANCE_NAME"
        procd_set_param env HOME=/tmp/root USER=root LOGNAME=root SHELL=/usr/bin/zsh
        procd_set_param command "$PROG"
        add_command_args

        [ -n "$RUN_USER" ] && procd_set_param user "$RUN_USER"
        [ -n "$RUN_GROUP" ] && procd_set_param group "$RUN_GROUP"
        [ "$RESPAWN" = "1" ] && procd_set_param respawn 3600 5 5
        [ "$STDOUT" = "1" ] && procd_set_param stdout 1
        [ "$STDERR" = "1" ] && procd_set_param stderr 1

        procd_close_instance
}

stop_service() {
        # rc.common/procd handles the real stop operation.
        return 0
}

restart() {
        stop
        sleep 1
        start
}

status() {
        local service_name="${initscript##*/}"
        local state
        local pid_name

        if command -v ubus >/dev/null 2>&1; then
                state="$(ubus call service list "{\"name\":\"$service_name\"}" 2>/dev/null)"
                if echo "$state" | grep -q '"running"[[:space:]]*:[[:space:]]*true'; then
                        echo "$service_name is running"
                        return 0
                fi
        fi

        pid_name="${PROG##*/}"
        if command -v pidof >/dev/null 2>&1 && pidof "$pid_name" >/dev/null 2>&1; then
                echo "$service_name may be running, matched process: $pid_name"
                return 0
        fi

        echo "$service_name is not running"
        return 1
}

health() {
        if [ -z "$CHECK_CMD" ]; then
                echo "health check not configured"
                return 2
        fi

        "$CHECK_CMD" $CHECK_ARGS
}
